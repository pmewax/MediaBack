<Window x:Class="MediaBack.UI.CropWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Loc.CropTitle}" Width="780" Height="570" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#111722" FontFamily="Segoe UI">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{DynamicResource Loc.CropHeading}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc.CropHint}" Style="{StaticResource Hint}" Margin="0,8,0,20"/></StackPanel>
  <Border Grid.Row="1" Background="#080D15" CornerRadius="9" BorderBrush="#38465E" BorderThickness="1" Padding="12" VerticalAlignment="Center"><Canvas x:Name="Viewport" Width="680" Height="245" Background="Black" ClipToBounds="True" Cursor="SizeAll" MouseLeftButtonDown="StartDrag" MouseMove="MoveDrag" MouseLeftButtonUp="EndDrag" LostMouseCapture="LostCapture" MouseWheel="ZoomWheel"><Image x:Name="Picture" IsHitTestVisible="False" Stretch="Fill"/><Grid x:Name="Guides" Width="680" Height="245" IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="#40FFFFFF" BorderThickness="1,0"/><Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#40FFFFFF" BorderThickness="0,1"/></Grid></Canvas></Border>
  <Grid Grid.Row="2" Margin="0,22,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock x:Name="ZoomLabel" Text="{DynamicResource Loc.ZoomDefault}" FontSize="12" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="ZoomSlider" Minimum="1" Maximum="4" Value="1" ValueChanged="ZoomChanged"/><Button Grid.Column="2" Content="{DynamicResource Loc.Center}" Click="CenterClicked" Margin="14,0,0,0" Padding="9,7"/></Grid>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource Loc.Cancel}" IsCancel="True" Margin="0,0,10,0"/><Button Content="{DynamicResource Loc.UseBackground}" IsDefault="True" Background="#365476" Click="SaveClicked"/></StackPanel>
 </Grid>
</Window>
