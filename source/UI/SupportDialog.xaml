<Window x:Class="MediaBack.UI.SupportDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Loc.SupportTitle}" Width="580" SizeToContent="Height"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
 Foreground="#F1F5FC" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style x:Key="CloseButton" TargetType="Button">
   <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="0"/>
   <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="#1C2A3D"/><Setter Property="Foreground" Value="#B7C8E0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}">
     <Path x:Name="CloseMark" Width="12" Height="12" Data="M 0,0 L 12,12 M 12,0 L 0,12"
      Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#30445F"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#3D5576"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9FCBFF"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Height" Value="46"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3677B4"/><GradientStop Color="#6267B2" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="16,10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C7E6FF"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ChoiceButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="#17263A"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#2D405D" BorderThickness="1" CornerRadius="12" Padding="18,14"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#223852"/><Setter TargetName="Surface" Property="BorderBrush" Value="#73B6E9"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B5D7FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2C4565"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border Margin="16" CornerRadius="20" BorderBrush="#3C506D" BorderThickness="1">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#192C43"/><GradientStop Color="#111C2C" Offset=".55"/><GradientStop Color="#24243B" Offset="1"/></LinearGradientBrush></Border.Background>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="24,22,22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="BackButton" Click="BackClicked" Width="36" Height="36" MinHeight="0" Padding="0" Visibility="Collapsed" Background="#1E3048" Margin="0,0,12,0" ToolTip="{DynamicResource Loc.Back}" AutomationProperties.Name="{DynamicResource Loc.Back}"><Path Width="13" Height="13" Data="M 8,0 L 1,6 L 8,12 M 1,6 L 14,6" Stretch="Uniform" Stroke="#C7DBF5" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Assets/MediaBack.png" Width="26" Height="26" Margin="0,0,10,0"/><StackPanel><TextBlock Text="MediaBack" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc.MadeWithLove}" FontSize="8" Foreground="#88A2C2" Margin="0,3,0,0"/></StackPanel></StackPanel>
    <Button x:Name="CloseDialogButton" Grid.Column="2" Style="{StaticResource CloseButton}" Click="CloseClicked" ToolTip="{DynamicResource Loc.Close}" AutomationProperties.Name="{DynamicResource Loc.CloseSupport}"/>
   </Grid>
   <ScrollViewer x:Name="DialogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,4,0">
    <StackPanel x:Name="PageBody" Margin="28,24,24,0">
     <Border x:Name="HeartBadge" Width="74" Height="74" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,20" BorderBrush="#4C5B82" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#254566"/><GradientStop Color="#524365" Offset="1"/></LinearGradientBrush></Border.Background><Viewbox Width="32" Height="30"><Path Data="M 12,22 C 10,20 0,13 0,7 C 0,-1 10,-3 12,4 C 15,-3 24,-1 24,7 C 24,13 14,20 12,22 Z" Fill="#F1C0D7"/></Viewbox></Border>
     <TextBlock x:Name="DialogTitle" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" LineHeight="33"/>
     <TextBlock x:Name="DialogSubtitle" FontSize="13" Foreground="#A9BCD6" TextAlignment="Center" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,24"/>
     <StackPanel x:Name="GreetingPage">
      <TextBlock Text="{DynamicResource Loc.GreetingLine}" FontSize="13" Foreground="#C4D4E8" TextAlignment="Center" TextWrapping="Wrap" Margin="8,0,8,20"/>
      <Button x:Name="GreetingSupportButton" Content="{DynamicResource Loc.SupportHeart}" Style="{StaticResource PrimaryButton}" Click="GreetingSupportClicked"/>
      <Button x:Name="GreetingSettingsButton" Content="{DynamicResource Loc.GoSettings}" Click="CloseClicked" Background="Transparent" Foreground="#B8C9E0" Margin="0,10,0,0" Height="42"/>
     </StackPanel>
     <Grid x:Name="CoinPage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button x:Name="TrxButton" Style="{StaticResource ChoiceButton}" Click="TrxClicked" Height="154"><StackPanel HorizontalAlignment="Center"><Border Width="42" Height="42" CornerRadius="15" Background="#583340" Margin="0,0,0,12"><TextBlock Text="T" FontSize="23" FontWeight="SemiBold" Foreground="#FFB8C1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="TRX" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Loc.TronNetwork}" Foreground="#9EB3CD" FontSize="12" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="UsdtButton" Grid.Column="2" Style="{StaticResource ChoiceButton}" Click="UsdtClicked" Height="154"><StackPanel HorizontalAlignment="Center"><Border Width="42" Height="42" CornerRadius="15" Background="#24483F" Margin="0,0,0,12"><TextBlock Text="₮" FontSize="25" FontWeight="SemiBold" Foreground="#B7F0D9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="USDT" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Loc.ChooseNetwork}" Foreground="#9EB3CD" FontSize="12" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
     </Grid>
     <ItemsControl x:Name="NetworkPage" Visibility="Collapsed"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ChoiceButton}" Click="NetworkClicked" Margin="0,0,0,10" Height="56"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayNetwork}" FontSize="14" VerticalAlignment="Center"/><Path Grid.Column="1" Width="6" Height="10" Data="M 0,0 L 5,5 L 0,10" Stretch="Uniform" Stroke="#91AECF" StrokeThickness="1.6" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <StackPanel x:Name="WalletPage" Visibility="Collapsed">
      <Border Background="White" CornerRadius="14" Padding="14" HorizontalAlignment="Center" Margin="0,0,0,20"><Image x:Name="QrImage" Width="222" Height="222" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="{DynamicResource Loc.QrAddressName}"/></Border>
      <TextBlock Text="{DynamicResource Loc.WalletAddress}" FontSize="12" Foreground="#B2C6E0" Margin="0,0,0,8"/>
      <TextBox x:Name="WalletAddress" IsReadOnly="True" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" MinHeight="46" Padding="12,10" Background="#101C2C" AutomationProperties.Name="{DynamicResource Loc.PublicAddressName}"/>
      <Button x:Name="CopyAddressButton" Content="{DynamicResource Loc.CopyAddress}" Style="{StaticResource PrimaryButton}" Click="CopyClicked" Margin="0,12,0,0"/>
      <TextBlock x:Name="WalletNotice" Foreground="#A7CBBF" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" LineHeight="19" Margin="0,12,0,0"/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <TextBlock x:Name="DialogFooter" Grid.Row="2" Text="{DynamicResource Loc.SupportOptional}" Foreground="#859CB9" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="24,22,24,24"/>
  </Grid>
 </Border>
</Window>
