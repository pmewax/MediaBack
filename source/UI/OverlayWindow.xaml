<Window x:Class="MediaBack.UI.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Loc.OverlayTitle}" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" SizeToContent="WidthAndHeight" Focusable="False" UseLayoutRounding="True" FontFamily="Segoe UI">
 <Window.Resources>
  <Style x:Key="VolumeSlider" TargetType="Slider">
   <Setter Property="Orientation" Value="Vertical"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Focusable" Value="False"/><Setter Property="Height" Value="Auto"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Width="34" Background="Transparent"><Track x:Name="PART_Track" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="{DynamicResource Accent}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Width="4" CornerRadius="2" Background="{TemplateBinding Background}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="13" Height="7" Background="{DynamicResource Accent}" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Handle" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="#30FFFFFF" BorderThickness="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="#555B64" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Width="4" CornerRadius="2" Background="{TemplateBinding Background}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track></Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="Root" Background="Transparent" CornerRadius="6" MouseEnter="OnMouseEnterPanel" MouseLeave="OnMouseLeavePanel" PreviewMouseWheel="OnWheel">
  <Border.LayoutTransform><ScaleTransform x:Name="PanelScale"/></Border.LayoutTransform>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="BackgroundGroup" Grid.RowSpan="2" IsHitTestVisible="False">
    <Border x:Name="SolidLayer" Background="#22252B" CornerRadius="6"/>
    <Border x:Name="ImageLayer" CornerRadius="6"/>
    <Border x:Name="ShadeLayer" Background="Black" CornerRadius="6" Opacity="0"/>
   </Grid>
   <Border x:Name="Outline" Grid.RowSpan="2" BorderBrush="#454A53" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False"/>
   <Grid x:Name="ContentGrid" Height="164">
    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Margin="15,12,15,11">
     <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/><RowDefinition x:Name="NumberRow" Height="28"/></Grid.RowDefinitions>
     <Button x:Name="MuteButton" Style="{StaticResource GlyphButton}" Content="&#xE767;" Width="32" Height="26" Click="MuteClicked" AutomationProperties.Name="{DynamicResource Loc.Mute}"/>
     <Slider x:Name="VolumeSlider" Grid.Row="1" Style="{StaticResource VolumeSlider}" ValueChanged="VolumeChanged" Margin="0,7,0,8" AutomationProperties.Name="{DynamicResource Loc.MasterVolume}"/>
     <TextBlock x:Name="VolumeText" Grid.Row="2" Text="50" FontSize="20" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <Border x:Name="MediaPanel" Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="#30FFFFFF" Width="376">
     <Grid Margin="18,14,18,12">
      <Grid.RowDefinitions><RowDefinition x:Name="SourceRow" Height="22"/><RowDefinition Height="*"/><RowDefinition x:Name="ControlsRow" Height="36"/></Grid.RowDefinitions>
      <TextBlock x:Name="SourceText" Text="{DynamicResource Loc.MusicCaps}" FontSize="10" Foreground="#B9BEC7" TextTrimming="CharacterEllipsis"/>
      <Grid Grid.Row="1" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ArtworkColumn" Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border x:Name="ArtworkBorder" Width="56" Height="56" HorizontalAlignment="Left" Background="#303740" CornerRadius="3"><Grid><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D6;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AEB8C6"/><Image x:Name="Cover" Stretch="UniformToFill"/></Grid></Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="TitleText" Text="{DynamicResource Loc.TrackTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ArtistText" Text="{DynamicResource Loc.Artist}" Foreground="#B9BEC7" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      </Grid>
      <StackPanel x:Name="ControlsPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
       <Button x:Name="PreviousButton" Style="{StaticResource GlyphButton}" Content="&#xE892;" AutomationProperties.Name="{DynamicResource Loc.PreviousTrack}" Click="PreviousClicked"/>
       <Button x:Name="PlayButton" Style="{StaticResource GlyphButton}" Content="&#xE769;" Margin="12,0" AutomationProperties.Name="{DynamicResource Loc.PlayPauseName}" Click="PlayClicked"/>
       <Button x:Name="NextButton" Style="{StaticResource GlyphButton}" Content="&#xE893;" AutomationProperties.Name="{DynamicResource Loc.NextTrack}" Click="NextClicked"/>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
   <TextBlock x:Name="GameHint" Grid.Row="1" Visibility="Collapsed" Text="{DynamicResource Loc.GameModeActive}" TextAlignment="Center" Foreground="#B2C7E1" FontSize="11" Margin="16,0,16,12" TextWrapping="Wrap"/>
  </Grid>
 </Border>
</Window>
