<Window x:Class="MediaBack.UI.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Loc.SettingsTitle}" Icon="/Assets/MediaBack.ico" Width="1100" Height="850" MinWidth="900" MinHeight="650" Background="#10151F" Foreground="#F3F5FA" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#171C26" BorderBrush="#272D38" BorderThickness="0,0,1,0">
   <Grid Margin="20,28,18,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><Image Source="/Assets/MediaBack.png" Width="32" Height="32" Margin="0,0,9,0"/><TextBlock Text="MediaBack" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{DynamicResource Loc.Tagline}" Foreground="#8592A6" FontSize="11" Margin="0,8,0,18"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock Text="{DynamicResource Loc.Language}" Foreground="#8592A6" FontSize="11" Margin="10,0,0,6"/>
     <ComboBox x:Name="LanguageBox" SelectionChanged="LanguageSelected" Margin="0,0,0,12"><ComboBoxItem Content="Русский · RU"/><ComboBoxItem Content="English · EN"/></ComboBox>
     <RadioButton x:Name="AppearanceNav" Content="{DynamicResource Loc.Appearance}" GroupName="Navigation" Tag="0" Style="{StaticResource NavItem}" IsChecked="True" Checked="Navigate"/>
     <RadioButton Content="{DynamicResource Loc.Position}" GroupName="Navigation" Tag="1" Style="{StaticResource NavItem}" Checked="Navigate"/>
     <RadioButton Content="{DynamicResource Loc.Music}" GroupName="Navigation" Tag="2" Style="{StaticResource NavItem}" Checked="Navigate"/>
     <RadioButton x:Name="ControlNav" Content="{DynamicResource Loc.Controls}" GroupName="Navigation" Tag="3" Style="{StaticResource NavItem}" Checked="Navigate"/>
     <RadioButton x:Name="SupportNav" Content="{DynamicResource Loc.SupportHeart}" GroupName="Navigation" Tag="4" Style="{StaticResource NavItem}" Checked="Navigate" Margin="0,4,0,7" Foreground="#E9B8D0"/>
    </StackPanel></ScrollViewer>
    <StackPanel x:Name="SidebarFooter" Grid.Row="2"><TextBlock x:Name="ShortcutSummary" Foreground="#C2D7F3" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource Loc.ShowAnytime}" Foreground="#8592A6" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,12"/><Button Content="{DynamicResource Loc.Done}" Click="ExitClicked" Background="#304D72"/><Button Content="{DynamicResource Loc.Quit}" Click="ShutdownClicked" Margin="0,8,0,0" ToolTip="{DynamicResource Loc.QuitHint}"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Image Source="/Assets/MediaBack.png" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="MediaBack" FontSize="11" Foreground="#71839C" VerticalAlignment="Center"/></StackPanel></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="32,28,32,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,20,0"><TextBlock x:Name="PageTitle" Text="{DynamicResource Loc.Appearance}" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="{DynamicResource Loc.AppearanceSubtitle}" Foreground="#8E9CB1" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
    <Button Grid.Column="1" Content="{DynamicResource Loc.ShowFlyout}" Click="PreviewClicked" Background="#334C69" VerticalAlignment="Center" Padding="18,12"/>
   </Grid>
   <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,28,24">
    <Grid>
     <StackPanel x:Name="AppearanceSection">
      <Border CornerRadius="12" Padding="22,18" Margin="0,0,0,18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#273D58"/><GradientStop Color="#202938" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel><TextBlock Text="{DynamicResource Loc.Minimalism}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc.SolidDefault}" Foreground="#AEBCD0" Margin="0,7,0,0" FontSize="12"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="{DynamicResource Loc.StyleAccent}" Style="{StaticResource SectionTitle}"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource Loc.PanelTheme}" Style="{StaticResource FieldTitle}"/><ComboBox x:Name="ThemeBox" SelectionChanged="SettingChanged"><ComboBoxItem Content="{DynamicResource Loc.Graphite}"/><ComboBoxItem Content="{DynamicResource Loc.Midnight}"/><ComboBoxItem Content="{DynamicResource Loc.Warm}"/><ComboBoxItem Content="{DynamicResource Loc.Classic}"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Loc.AccentColor}" Style="{StaticResource FieldTitle}"/><ComboBox x:Name="AccentBox" SelectionChanged="SettingChanged"><ComboBoxItem Content="{DynamicResource Loc.IceBlue}"/><ComboBoxItem Content="{DynamicResource Loc.WindowsBlue}"/><ComboBoxItem Content="{DynamicResource Loc.Lavender}"/><ComboBoxItem Content="{DynamicResource Loc.Mint}"/><ComboBoxItem Content="{DynamicResource Loc.Peach}"/><ComboBoxItem Content="{DynamicResource Loc.White}"/><ComboBoxItem Content="{DynamicResource Loc.CustomColor}"/></ComboBox></StackPanel>
       </Grid>
       <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Loc.CustomHex}" VerticalAlignment="Center" Foreground="#AAB5C5" FontSize="12"/><TextBox x:Name="AccentHexBox" Grid.Column="1" TextChanged="CoordinateChanged" MaxLength="7" AutomationProperties.Name="{DynamicResource Loc.HexName}"/></Grid>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="{DynamicResource Loc.SizeShape}" Style="{StaticResource SectionTitle}"/>
       <TextBlock x:Name="ScaleLabel" Style="{StaticResource FieldTitle}"/><Slider x:Name="ScaleSlider" Minimum="80" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderChanged"/>
       <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="WidthLabel" Style="{StaticResource FieldTitle}"/><Slider x:Name="WidthSlider" Minimum="300" Maximum="600" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="SliderChanged"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock x:Name="HeightLabel" Style="{StaticResource FieldTitle}"/><Slider x:Name="HeightSlider" Minimum="144" Maximum="224" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="SliderChanged"/></StackPanel>
       </Grid>
       <TextBlock x:Name="RadiusLabel" Style="{StaticResource FieldTitle}" Margin="0,18,0,8"/><Slider x:Name="RadiusSlider" Minimum="0" Maximum="22" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderChanged"/>
       <CheckBox x:Name="BorderBox" Content="{DynamicResource Loc.ThinBorder}" Click="SettingClicked" Margin="0,16,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="{DynamicResource Loc.CustomBackground}" Style="{StaticResource SectionTitle}"/>
       <Border Height="115" CornerRadius="8" Background="#121923" BorderBrush="#303B4D" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,14"><Grid><Image x:Name="ImportedPreview" Stretch="UniformToFill"/><Border Background="#50000000"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="BackgroundName" Text="{DynamicResource Loc.YourImage}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Loc.ImageFormats}" FontSize="11" Foreground="#AAB8CA" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
       <WrapPanel><Button Content="{DynamicResource Loc.ChooseImage}" Click="ImportBackground" Background="#304963" Margin="0,0,8,8"/><Button x:Name="CropAgainButton" Content="{DynamicResource Loc.Crop}" Click="CropBackground" Margin="0,0,8,8"/><Button Content="{DynamicResource Loc.RemoveBackground}" Click="RemoveBackground" Margin="0,0,0,8"/></WrapPanel>
       <TextBlock x:Name="OpacityLabel" Style="{StaticResource FieldTitle}" Margin="0,12,0,8"/><Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderChanged"/>
       <TextBlock Text="{DynamicResource Loc.OpacityHint}" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
       <TextBlock x:Name="ShadeLabel" Style="{StaticResource FieldTitle}" Margin="0,16,0,8"/><Slider x:Name="ShadeSlider" Minimum="0" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderChanged"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Loc.PanelContents}" Style="{StaticResource SectionTitle}"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><CheckBox x:Name="ArtworkBox" Content="{DynamicResource Loc.Artwork}" Click="SettingClicked"/><CheckBox x:Name="SourceVisibleBox" Content="{DynamicResource Loc.AppName}" Click="SettingClicked"/><CheckBox x:Name="ArtistVisibleBox" Content="{DynamicResource Loc.Artist}" Click="SettingClicked"/></StackPanel><StackPanel Grid.Column="1"><CheckBox x:Name="VolumeNumberBox" Content="{DynamicResource Loc.VolumeNumber}" Click="SettingClicked"/><CheckBox x:Name="MediaControlsBox" Content="{DynamicResource Loc.PlayerButtons}" Click="SettingClicked"/></StackPanel></Grid>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="PositionSection" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Loc.PanelLocation}" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="{DynamicResource Loc.ScreenCorner}" Style="{StaticResource FieldTitle}"/><ComboBox x:Name="CornerBox" SelectionChanged="SettingChanged"><ComboBoxItem Content="{DynamicResource Loc.TopLeft}"/><ComboBoxItem Content="{DynamicResource Loc.TopRight}"/><ComboBoxItem Content="{DynamicResource Loc.BottomLeft}"/><ComboBoxItem Content="{DynamicResource Loc.BottomRight}"/><ComboBoxItem Content="{DynamicResource Loc.CustomCoordinates}"/></ComboBox>
       <TextBlock Text="{DynamicResource Loc.Monitor}" Style="{StaticResource FieldTitle}" Margin="0,18,0,8"/><ComboBox x:Name="MonitorBox" SelectionChanged="SettingChanged"><ComboBoxItem Content="{DynamicResource Loc.PrimaryMonitor}"/><ComboBoxItem Content="{DynamicResource Loc.CursorMonitor}"/></ComboBox>
       <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Loc.OffsetX}" Style="{StaticResource FieldTitle}"/><TextBox x:Name="XBox" TextChanged="CoordinateChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Loc.OffsetY}" Style="{StaticResource FieldTitle}"/><TextBox x:Name="YBox" TextChanged="CoordinateChanged"/></StackPanel></Grid>
       <TextBlock x:Name="CoordinateHint" Text="{DynamicResource Loc.CoordinateHint}" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Loc.DisplayTime}" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="FadeBox" Content="{DynamicResource Loc.FadeOut}" Click="SettingClicked" Margin="0,0,0,14"/><TextBlock x:Name="FadeLabel" Style="{StaticResource FieldTitle}"/><Slider x:Name="FadeSlider" Minimum="100" Maximum="600" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="SliderChanged" Margin="0,0,0,18"/><TextBlock x:Name="TimeoutLabel" Style="{StaticResource FieldTitle}"/><Slider x:Name="TimeoutSlider" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderChanged"/><CheckBox x:Name="HoverBox" Content="{DynamicResource Loc.HoldHover}" Click="SettingClicked" Margin="0,18,0,0"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="MusicSection" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Loc.MusicSource}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{DynamicResource Loc.Player}" Style="{StaticResource FieldTitle}"/><ComboBox x:Name="SourceBox" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="SourceChanged"/><Border Background="#151D29" CornerRadius="8" Padding="14" Margin="0,14,0,14"><TextBlock x:Name="TrackStatus" Text="{DynamicResource Loc.Searching}" TextWrapping="Wrap" FontSize="13" Foreground="#B2C7E1"/></Border><CheckBox x:Name="MusicOnlyBox" Content="{DynamicResource Loc.MusicOnly}" Click="SettingClicked"/><TextBlock Text="{DynamicResource Loc.PinHint}" Style="{StaticResource Hint}" Margin="0,10,0,16"/><WrapPanel><Button Content="{DynamicResource Loc.ExcludeSource}" Click="ExcludeClicked" Margin="0,0,8,8"/><Button x:Name="ClearExcludedButton" Content="{DynamicResource Loc.ResetExclusions}" Click="ClearExcludedClicked" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="WebsiteBox" Content="{DynamicResource Loc.ShowWebsite}" Click="SettingClicked" Margin="0,0,0,10"/><TextBlock Text="{DynamicResource Loc.WebsiteHint}" Style="{StaticResource Hint}" Margin="0,0,0,18"/><TextBlock Text="{DynamicResource Loc.ConnectPlayers}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{DynamicResource Loc.ConnectPlayersHint}" Style="{StaticResource Hint}"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="ControlSection" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="{DynamicResource Loc.GameModeTitle}" Style="{StaticResource SectionTitle}"/>
       <CheckBox x:Name="CursorHoverBox" Content="{DynamicResource Loc.CursorHover}" Click="SettingClicked"/>
       <CheckBox x:Name="SmoothVolumeBox" Content="{DynamicResource Loc.SmoothVolume}" Click="SettingClicked"/>
       <TextBlock Text="{DynamicResource Loc.GameModeHint}" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Loc.WhenShow}" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="VolumeHookBox" Content="{DynamicResource Loc.ReplaceVolume}" Click="SettingClicked"/><CheckBox x:Name="HardwareBox" Content="{DynamicResource Loc.Hardware}" Click="SettingClicked"/><TextBlock Text="{DynamicResource Loc.HardwareHint}" Style="{StaticResource Hint}" Margin="26,2,0,12"/><CheckBox x:Name="ShowMediaKeysBox" Content="{DynamicResource Loc.ShowMediaKeys}" Click="SettingClicked"/><CheckBox x:Name="StartupBox" Content="{DynamicResource Loc.ShowOnStartup}" Click="SettingClicked"/><Border Background="#142A28" CornerRadius="8" Padding="14" Margin="0,16,0,0"><TextBlock Text="{DynamicResource Loc.MixerHint}" TextWrapping="Wrap" Foreground="#A7D3C6" FontSize="12"/></Border></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="AutostartBox" Content="{DynamicResource Loc.Autostart}" Click="AutostartClicked" Margin="0,0,0,18"/><CheckBox x:Name="TrayIconBox" Content="{DynamicResource Loc.TrayIcon}" Click="SettingClicked"/><TextBlock Text="{DynamicResource Loc.TrayHint}" TextWrapping="Wrap" Foreground="#8E9CB1" FontSize="12" Margin="0,8,0,20"/><TextBlock Text="{DynamicResource Loc.VolumeMediaKeys}" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="StepLabel" Style="{StaticResource FieldTitle}"/><Slider x:Name="StepSlider" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderChanged"/><CheckBox x:Name="MediaHookBox" Content="{DynamicResource Loc.PinnedKeys}" Click="SettingClicked" Margin="0,18,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Loc.QuickCommands}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/><Button x:Name="ResetShortcuts" Grid.Column="1" Content="{DynamicResource Loc.Reset}" Click="ResetShortcutsClicked" Padding="12,7" FontSize="12"/></Grid>
       <CheckBox x:Name="ShortcutsEnabledBox" Content="{DynamicResource Loc.EnableShortcuts}" Click="ShortcutsEnabledClicked" Margin="0,0,0,18"/>
       <StackPanel x:Name="ShortcutRows"/>
       <TextBlock x:Name="ShortcutStatus" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
       <Border Background="#141E2D" CornerRadius="8" Padding="12" Margin="0,16,0,0"><TextBlock Text="{DynamicResource Loc.KeysSeparateHint}" Style="{StaticResource Hint}"/></Border>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="SupportSection" Visibility="Collapsed">
      <Border CornerRadius="16" BorderBrush="#344C6C" BorderThickness="1" Padding="28" Margin="0,0,0,20">
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1D3650"/><GradientStop Color="#1A263B" Offset=".6"/><GradientStop Color="#302C45" Offset="1"/></LinearGradientBrush></Border.Background>
       <StackPanel>
        <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border Width="52" Height="52" CornerRadius="17" Background="#31415D" BorderBrush="#536182" BorderThickness="1" VerticalAlignment="Top"><Viewbox Width="24" Height="23"><Path Data="M 12,22 C 10,20 0,13 0,7 C 0,-1 10,-3 12,4 C 15,-3 24,-1 24,7 C 24,13 14,20 12,22 Z" Fill="#EFC4D9"/></Viewbox></Border>
         <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Loc.Together}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource Loc.SupportGrows}" Foreground="#9FB8D5" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
        </Grid>
        <TextBlock Text="{DynamicResource Loc.SupportParagraph}" FontSize="14" LineHeight="23" Foreground="#C6D5E8" TextWrapping="Wrap"/>
        <Button x:Name="ChooseCoinButton" Content="{DynamicResource Loc.ChooseSupportCoin}" Click="ChooseSupportCoin" HorizontalAlignment="Left" MinWidth="260" Height="46" Margin="0,24,0,0" FontSize="13" Padding="20,10"><Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3578B5"/><GradientStop Color="#6268AD" Offset="1"/></LinearGradientBrush></Button.Background></Button>
        <TextBlock Text="{DynamicResource Loc.SupportCoinsHint}" Foreground="#93ADC9" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="{DynamicResource Loc.SupportEasy}" Style="{StaticResource SectionTitle}"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="01" Foreground="#80BDE8" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc.Coin}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock Text="{DynamicResource Loc.ChooseTrxUsdt}" Style="{StaticResource Hint}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="02" Foreground="#9AADEB" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc.Network}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock Text="{DynamicResource Loc.UsdtNetwork}" Style="{StaticResource Hint}"/></StackPanel>
        <StackPanel Grid.Column="4"><TextBlock Text="03" Foreground="#CAB5DE" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc.AddressQr}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock Text="{DynamicResource Loc.ScanCopy}" Style="{StaticResource Hint}"/></StackPanel>
       </Grid>
      </StackPanel></Border>
      <Border Background="#152A2B" BorderBrush="#264248" BorderThickness="1" CornerRadius="11" Padding="18"><TextBlock Text="{DynamicResource Loc.SupportThanks}" TextWrapping="Wrap" Foreground="#B3D4CD" FontSize="13" LineHeight="21"/></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <Border Grid.Row="2" Background="#151A23" BorderBrush="#282F3B" BorderThickness="0,1,0,0" Padding="32,12"><StackPanel><TextBlock x:Name="NoticeText" Foreground="#E7BD83" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{DynamicResource Loc.AutosaveHint}" Foreground="#7F8DA3" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
  </Grid>
 </Grid>
</Window>
