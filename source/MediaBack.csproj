<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MediaBack</AssemblyName>
    <Version>0.4.2</Version>
    <ApplicationIcon>Assets/MediaBack.ico</ApplicationIcon>
    <Description>Громкость и музыка в привычной панели</Description>
    <Product>MediaBack</Product>
    <Authors>MediaBack</Authors>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization/Strings.*.json" LogicalName="MediaBack.%(Filename)%(Extension)" WithCulture="false" />
    <Resource Include="Assets/MediaBack.png" />
    <Resource Include="Assets/MediaBack.ico" />
    <Resource Include="Assets/Support/*" />
    <EmbeddedResource Include="Assets/MediaBack.ico" LogicalName="MediaBack.BrandIcon" />
  </ItemGroup>
  <Target Name="PinServicedRuntime" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App;Microsoft.WindowsDesktop.App.WPF;Microsoft.WindowsDesktop.App.WindowsForms" RuntimeFrameworkVersion="10.0.13" />
    </ItemGroup>
  </Target>
</Project>
